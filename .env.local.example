# ── HER Environment Variables ───────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── AI Provider Router ─────────────────────────────────────
# Options: "nvidia" (recommended) or "opencode"
PRIMARY_PROVIDER=nvidia

# ── NVIDIA NIM (Master Key Setup) ───────────────────────────
# One master API key powers Language Chat, Image Generation & Editing (Flux), and Vision!
# Get your key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_master_key_here

# (Optional overrides - if omitted, they automatically use NVIDIA_API_KEY above)
# NVIDIA_CHAT_API_KEY=your_chat_key_here
# NVIDIA_IMAGE_API_KEY=your_image_key_here
# NVIDIA_VISION_API_KEY=your_vision_key_here

# ── Speech-to-Text (STT) for Phone Call Mode ──────────────────
# Powers real-time conversational phone calls with Samantha (~150ms latency, zero chime)
# Get a 100% free key with no credit card at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Active Chat Model (Free NIM endpoint — auto-falls back to healthy models if deprecated)
# Tested active endpoints:
#   - meta/llama-3.2-11b-vision-instruct (Default: fast ~900ms, streaming, multimodal)
#   - nvidia/nemotron-3-nano-omni-30b-a3b-reasoning (Active 30B reasoning)
#   - nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_CHAT_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# ── OpenCode Zen (Optional Secondary Provider) ──────────────
OPENCODE_ZEN_API_KEY=your_opencode_key_here
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=deepseek-ai/deepseek-v4-pro

# ── Supabase (Public Frontend Keys) ────────────────────────
# Project URL: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Anon/Public key: Project Settings → API → anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Supabase (SERVER-ONLY — never expose to browser) ───────
# Service-role key bypasses Row Level Security. Required by cron jobs and
# privileged background routes. Get it from: Project Settings → API → service_role
# WARNING: Treat this like a database password. Never put in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Push Notifications (VAPID) ──────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your@email.com

# ── Cron Secret for vercel ─────────────────────────────────────────────
# Secures the /api/cron/* endpoints from unauthorized access
CRON_SECRET=your_random_secret_here
